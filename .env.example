# Postgres in docker compose; keep DATABASE_URL in step with these
POSTGRES_USER=greenquote
POSTGRES_PASSWORD=greenquote
POSTGRES_DB=greenquote
DATABASE_URL=postgres://greenquote:greenquote@localhost:5432/greenquote
PORT=3001
SEED_ADMIN_PASSWORD=change-me-admin-password
# Adds demo users (lena@test.com, tom@test.com, nina@test.com) and their quotes; false seeds only the admin
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=demo-password
# development | test | production; production marks the session cookie Secure (the API image sets it)
# NODE_ENV=development
# Signs session tokens; at least 32 characters (openssl rand -base64 32)
JWT_SECRET=change-me-to-a-random-secret-of-32-chars
# Address the E2E tests (pnpm test:e2e) open; defaults to the web app on :3000
# E2E_BASE_URL=http://localhost:3000
